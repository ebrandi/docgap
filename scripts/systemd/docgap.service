[Unit]
Description=docgap - Documentation Gap Detector
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/docgap run
StandardOutput=append:/var/lib/docgap/logs/cron.log
StandardError=append:/var/lib/docgap/logs/cron.log
User=root

# Hardening
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/docgap /etc/docgap
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
